#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 CodeFriendly
# SPDX-License-Identifier: MIT
set -euo pipefail

if [[ ${CODEFRIENDLY_REPO:-false} == true ]]; then
  # Trust only the pinned repository key, inside this disposable container.
  fingerprint=AFA2FD35394F39A761B783E57695B10F4DFB18FE
  curl -fSLo /tmp/codefriendly-repo.asc https://repo.codefriendly.com/arch/codefriendly-repo.asc
  actual=$(gpg --batch --show-keys --with-colons /tmp/codefriendly-repo.asc | awk -F: '$1 == "fpr" { print $10; exit }')
  [[ $actual == "$fingerprint" ]] || { echo 'Repository key fingerprint mismatch.' >&2; exit 1; }
  pacman-key --init
  pacman-key --add /tmp/codefriendly-repo.asc
  pacman-key --lsign-key "$fingerprint"
  printf '\n[codefriendly]\nSigLevel = Required DatabaseRequired\nServer = https://repo.codefriendly.com/arch/$arch\n' >> /etc/pacman.conf
fi

# Upgrade the whole disposable environment before installing recipe dependencies.
pacman -Syu --noconfirm
chown -R builder:builder /build /output
exec sudo -u builder env PKGDEST=/output LOGDEST=/output bash -c '
  set -euo pipefail
  makepkg --printsrcinfo > /output/.SRCINFO
  if [[ -f .SRCINFO ]] && ! cmp -s .SRCINFO /output/.SRCINFO; then
    echo "Stale .SRCINFO: regenerate it with makepkg --printsrcinfo." >&2
    exit 1
  fi
  makepkg --cleanbuild --clean --syncdeps --noconfirm --log
  # A recipe can override makepkg.conf. Do not export debug packages.
  shopt -s nullglob
  for package in /output/*.pkg.tar.*; do
    name=$(LC_ALL=C pacman -Qp "$package" | cut -d " " -f 1)
    if [[ $name == *-debug ]]; then
      rm -- "$package"
      continue
    fi
    bsdtar -xOf "$package" .PKGINFO > "$package.PKGINFO"
    bsdtar -tf "$package" > "$package.files"
    namcap "$package" > "$package.namcap.log" 2>&1
    (cd /output && sha256sum "${package##*/}") > "$package.sha256"
  done
'
