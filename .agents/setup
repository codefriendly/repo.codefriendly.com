#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0

echo 'Checking system tools'
packages=(git python3 ca-certificates curl zstd shellcheck)
missing=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update -qq
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
# The orb's newer Git can use Debian's subtree command through PATH.
if [[ ! -x "$(git --exec-path)/git-subtree" ]] && ! command -v git-subtree >/dev/null; then
  sudo ln -s /usr/lib/git-core/git-subtree /usr/local/bin/git-subtree
fi
python3 -c 'import sys; assert sys.version_info >= (3, 11), "Python 3.11+ is required"'
node -e 'if (Number(process.versions.node.split(".")[0]) < 20) throw Error("Node.js 20+ is required")'
command -v npm >/dev/null
command -v uv >/dev/null

echo "System tools ready (${SECONDS}s)"
if ! command -v docker >/dev/null || ! command -v dockerd >/dev/null || ! docker buildx version >/dev/null 2>&1; then
  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
  sudo chmod a+r /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
    | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
  sudo apt-get update -qq
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin
fi
echo "Docker tools ready (${SECONDS}s); the daemon starts during resume"

uv tool install nvchecker
# Cache the same environment used by the documented uvx command.
uvx nvchecker --version
echo "Upstream checker ready (${SECONDS}s)"

npm --prefix site ci --ignore-scripts --no-audit --no-fund
echo "Website dependencies ready (${SECONDS}s)"
echo 'Setup complete. Use scripts/build arch <pkgbase> for container builds.'
