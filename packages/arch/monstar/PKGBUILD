# Maintainer: Tim Culverhouse <tim@timculverhouse.com>
# Based on AUR monstar commit 9b4505632201491a73a5b819ee013a2d7616e9a1.
pkgname=monstar
pkgver=1.0.1
pkgrel=2
_zigver=0.16.0
_z2dcommit=47fc1030c1636dcfb75ea1cc238f706dd1feb379
_uucodecommit=2826a37a4562284fdacd8fa029d49509cc9bffcd
pkgdesc='Linux-native Wayland terminal built on Ghostty terminal core'
arch=('x86_64')
url='https://github.com/rockorager/monstar'
license=('MIT' 'MPL-2.0' 'Unicode-3.0' 'BSD-3-Clause' 'Apache-2.0' 'Apache-2.0 WITH LLVM-exception' 'LicenseRef-W3C-Software-and-Document' 'LicenseRef-Xorg-RGB')
conflicts=('monstar-bin' 'monstar-git')
options=('!debug')
depends=(
  'dbus'
  'fontconfig'
  'freetype2'
  'glibc'
  'harfbuzz'
  'libxkbcommon'
  'wayland'
)
makedepends=(
  'ncurses'
  'wayland-protocols>=1.49'
)
checkdepends=('noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji')
optdepends=(
  'noto-fonts-emoji: emoji support'
  'noto-fonts-cjk: CJK font support'
  'systemd: launch additional terminal windows'
  'xdg-desktop-portal: open links and files through a desktop portal'
  'xdg-utils: open links when a desktop portal is unavailable'
)
source=(
  "$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver-source.tar.gz"
  "iterm2-Color-Schemes-LICENSE::https://raw.githubusercontent.com/mbadolato/iTerm2-Color-Schemes/8c97c3c684da58a19149d1080f3d18ff5e161c01/LICENSE"
  "https://ziglang.org/download/$_zigver/zig-x86_64-linux-$_zigver.tar.xz"
  "z2d-LICENSE::https://raw.githubusercontent.com/vancluever/z2d/$_z2dcommit/LICENSE"
  "z2d-COPYING::https://raw.githubusercontent.com/vancluever/z2d/$_z2dcommit/COPYING"
  "uucode-LICENSE_unicode::https://raw.githubusercontent.com/jacobsandlund/uucode/$_uucodecommit/licenses/LICENSE_unicode"
  "uucode-LICENSE_Bjoern_Hoehrmann::https://raw.githubusercontent.com/jacobsandlund/uucode/$_uucodecommit/licenses/LICENSE_Bjoern_Hoehrmann"
  'https://www.x.org/releases/individual/app/rgb-1.1.0.tar.xz'
  'highway-LICENSE-BSD3::https://raw.githubusercontent.com/google/highway/66486a10623fa0d72fe91260f96c892e41aceb06/LICENSE-BSD3'
  'simdutf-LICENSE-MIT::https://raw.githubusercontent.com/simdutf/simdutf/ca7acbcea967b5dcbab490066e99e3a6e6925539/LICENSE-MIT'
  'simdutf-LICENSE-APACHE::https://raw.githubusercontent.com/simdutf/simdutf/ca7acbcea967b5dcbab490066e99e3a6e6925539/LICENSE-APACHE'
  'LICENSES.md'
)
