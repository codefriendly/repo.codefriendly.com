prepare() {
  cd "$pkgname-$pkgver"
  # Ghostty requires Zig 0.16.0; Arch's current Zig is not compatible.
  ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache" \
    "$srcdir/zig-x86_64-linux-$_zigver/zig" build --fetch
}

build() {
  cd "$pkgname-$pkgver"
  rm -rf "$srcdir/monstar-build"

  ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache" DESTDIR="$srcdir/monstar-build" \
    "$srcdir/zig-x86_64-linux-$_zigver/zig" build \
    --prefix /usr \
    --build-id=sha1 \
    -Doptimize=ReleaseFast \
    -Dcpu=baseline
}

check() {
  cd "$pkgname-$pkgver"
  ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache" \
    "$srcdir/zig-x86_64-linux-$_zigver/zig" build test --summary all
}

package() {
  cp -a "$srcdir/monstar-build/." "$pkgdir/"
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/iterm2-Color-Schemes-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/iterm2-Color-Schemes-LICENSE"
  install -Dm644 "$srcdir/$pkgname-$pkgver/src/assets/SymbolsNerdFontMono-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/SymbolsNerdFontMono-LICENSE"
  # The vendored stb headers contain their MIT notices, not separate license files.
  local header
  for header in stb_image.h stb_image_resize.h; do
    sed -n '/^ALTERNATIVE A - MIT License/,/^ALTERNATIVE B/{ /^ALTERNATIVE B/d; p; }' \
      "$srcdir/$pkgname-$pkgver/vendor/$header" > "$srcdir/$header-LICENSE"
    install -Dm644 "$srcdir/$header-LICENSE" \
      "$pkgdir/usr/share/licenses/$pkgname/$header-LICENSE"
  done
  # Zig keeps these content-hashed dependency sources in the project zig-pkg directory.
  local deps="$srcdir/$pkgname-$pkgver/zig-pkg"
  install -Dm644 "$deps"/ghostty-*/LICENSE "$pkgdir/usr/share/licenses/$pkgname/Ghostty-LICENSE"
  install -Dm644 "$deps"/wayland-*/LICENSE "$pkgdir/usr/share/licenses/$pkgname/zig-wayland-LICENSE"
  install -Dm644 "$deps"/uucode-*/LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/uucode-LICENSE.md"
  install -Dm644 "$srcdir/rgb-1.1.0/COPYING" "$pkgdir/usr/share/licenses/$pkgname/Xorg-RGB-COPYING"
  install -Dm644 "$srcdir"/z2d-LICENSE "$srcdir"/z2d-COPYING \
    "$srcdir"/uucode-LICENSE_unicode "$srcdir"/uucode-LICENSE_Bjoern_Hoehrmann \
    "$srcdir"/highway-LICENSE-BSD3 "$srcdir"/simdutf-LICENSE-MIT "$srcdir"/simdutf-LICENSE-APACHE \
    "$srcdir/LICENSES.md" -t "$pkgdir/usr/share/licenses/$pkgname/"
  # Keep all in-header third-party notices in Ghostty's amalgamated simdutf header.
  install -Dm644 "$deps"/ghostty-*/pkg/simdutf/vendor/simdutf.h \
    "$pkgdir/usr/share/licenses/$pkgname/simdutf-third-party-notices.h"
  # Preserve notices for Zig standard-library code and bundled runtime headers.
  install -Dm644 "$srcdir/zig-x86_64-linux-$_zigver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/Zig-LICENSE"
  local runtime
  for runtime in libcxx libcxxabi libunwind; do
    install -Dm644 "$srcdir/zig-x86_64-linux-$_zigver/lib/$runtime/LICENSE.TXT" \
      "$pkgdir/usr/share/licenses/$pkgname/$runtime-LICENSE.TXT"
  done
  # Include the exact MPL-covered source, with its original in-file notices.
  install -dm755 "$pkgdir/usr/share/doc/$pkgname"
  cp -a "$deps/z2d-0.12.2-pre-j5P_HtA8EQDpzu5RUtQhr_Sn9MeQF3_q7rWMw3ouesd0" \
    "$pkgdir/usr/share/doc/$pkgname/z2d-source"
  install -Dm644 "$srcdir/z2d-LICENSE" "$pkgdir/usr/share/doc/$pkgname/z2d-source/LICENSE"
  install -Dm644 "$srcdir/z2d-COPYING" "$pkgdir/usr/share/doc/$pkgname/z2d-source/COPYING"
}
