# Packaging based on remanager-bin by Kitty Dae Elliott <kdelliott@pm.me>.
pkgname=remanager
pkgver=1.7.4
pkgrel=1
pkgdesc='Open-source mod manager for reMarkable tablets'
arch=('x86_64')
url='https://remanager.io/'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'MIT' 'BSD-2-Clause' 'BSD-3-Clause' 'Apache-2.0' 'ISC' '0BSD')
depends=('gtk3' 'webkit2gtk-4.1' 'glibc' 'glib2' 'gdk-pixbuf2' 'libsoup3' 'hicolor-icon-theme')
makedepends=('go' 'npm' 'nodejs' 'python' 'pkgconf')
checkdepends=('desktop-file-utils')
optdepends=('gnome-keyring: store tablet passwords in the login keyring'
            'xdg-desktop-portal: native file dialogs')
conflicts=('remanager-bin')
options=('!debug' '!lto')
source=("reManager-$pkgver.tar.gz::https://github.com/rmitchellscott/reManager/archive/refs/tags/v$pkgver.tar.gz"
        'reManager.desktop' 'frontend-licenses.py' 'README.md'
        'radix-LICENSE::https://raw.githubusercontent.com/radix-ui/primitives/fcef0668a5c827e5a4baac405474d75680f9a4eb/LICENSE'
        'react-remove-scroll-bar-LICENSE::https://raw.githubusercontent.com/theKashey/react-remove-scroll-bar/7301c160fda44cb8cf2b9fdfde61efad35736196/LICENSE')
sha256sums=('3100c829de2dc1e26bf765f09a2eca796c02db93869ae945d065c344ab7400f1'
            'af71e3ee3c5c2f59f045a96ac4a8d4b609a2a66ed02ee05458a07536d022c94d'
            '5df1a74374d610beafc16bb34b220a4a5ad50c4fb0d2243b74085a9730a5adef'
            '24b69efa0cc684a8f9244a09d237f4183dfc346c89c11a9a140b10b1e6cce9e3'
            '0e80a2d229d2fd4fc7e8636142ec5d0ff0bc031f14c15b682e2ac01dfd5b5138'
            'a79aae0c0f21990d9d963bb3c5a79cdcea9a46f8523ba55c58d7fe776b6ebc84')

prepare() {
  cd "reManager-$pkgver"
  export GOPATH="$srcdir/go" GOTOOLCHAIN=local GOMAXPROCS=2
  go mod download
  go mod verify
  npm --prefix frontend ci --ignore-scripts --no-audit --no-fund
  # prepare() installed the locked dependencies; do not resolve them again.
  sed -i 's/"frontend:install": "npm install"/"frontend:install": ""/' wails.json
  python "$srcdir/frontend-licenses.py" frontend dependency-licenses
  GOBIN="$GOPATH/bin" GOFLAGS= go install github.com/google/go-licenses/v2@v2.0.1
  # Go's embed directive needs a file before Wails builds the actual frontend.
  mkdir -p frontend/dist
  touch frontend/dist/.placeholder
  export GOFLAGS='-mod=readonly -p=2 -tags=webkit2_41,production'
  "$GOPATH/bin/go-licenses" report . --ignore reManager > dependency-licenses/GO-LICENSES.csv
  "$GOPATH/bin/go-licenses" check . --ignore reManager \
    --allowed_licenses=LGPL-3.0,MIT,BSD-2-Clause,BSD-3-Clause,Apache-2.0,ISC
  go list -deps -f '{{with .Module}}{{.Path}}{{"\t"}}{{.Dir}}{{end}}' . \
    | sort -u > dependency-modules.tsv
  local module directory file
  while IFS=$'\t' read -r module directory; do
    [[ -n $module && $module != reManager ]] || continue
    while IFS= read -r -d '' file; do
      install -Dm644 "$file" "dependency-licenses/go/$module/${file#"$directory/"}"
    done < <(find "$directory" -type f \( -iname 'LICENSE*' -o -iname 'LICENCE*' \
      -o -iname 'COPYING*' -o -iname 'NOTICE*' -o -iname 'PATENTS*' \
      -o -iname 'COPYRIGHT*' \) -print0)
  done < dependency-modules.tsv
  cp /usr/share/licenses/go/LICENSE dependency-licenses/Go-LICENSE
  go mod vendor
  cp -a "$GOPATH/pkg/mod/cache/download" module-source
  chmod -R u+w "$GOPATH/pkg/mod" module-source
}

build() {
  cd "reManager-$pkgver"
  export GOPATH="$srcdir/go" GOTOOLCHAIN=local GOMAXPROCS=2
  export GOPROXY=off GOSUMDB=off GOFLAGS='-mod=vendor -p=2 -buildmode=pie'
  export CGO_LDFLAGS="$LDFLAGS"
  go build -o "$srcdir/wails" github.com/wailsapp/wails/v2/cmd/wails
  "$srcdir/wails" build -m -nosyncgomod -trimpath -tags webkit2_41 -ldflags "-X main.version=v$pkgver"
}

check() {
  cd "reManager-$pkgver"
  export GOPATH="$srcdir/go" GOTOOLCHAIN=local GOMAXPROCS=2
  export GOPROXY=off GOSUMDB=off GOFLAGS='-mod=vendor -p=2'
  go test -tags 'webkit2_41 production' ./...
  desktop-file-validate "$startdir/reManager.desktop"
}

package() {
  cd "reManager-$pkgver"
  install -Dm755 build/bin/reManager "$pkgdir/usr/bin/reManager"
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/reManager.svg"
  install -Dm644 "$startdir/reManager.desktop" "$pkgdir/usr/share/applications/reManager.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  cp -a dependency-licenses "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 "$startdir/README.md" "$pkgdir/usr/share/doc/$pkgname/PACKAGING.md"
  local archive="$pkgname-$pkgver-$pkgrel.src.tar.zst"
  tar --zstd -cf "${PKGDEST:-$startdir}/$archive" \
    --exclude="reManager-$pkgver/build/bin" \
    -C "$srcdir" "reManager-$pkgver" \
    -C "$startdir" PKGBUILD .SRCINFO README.md reManager.desktop frontend-licenses.py \
    radix-LICENSE react-remove-scroll-bar-LICENSE \
    "reManager-$pkgver.tar.gz"
  (cd "${PKGDEST:-$startdir}" && sha256sum "$archive") \
    > "${PKGDEST:-$startdir}/$archive.sha256"
}
