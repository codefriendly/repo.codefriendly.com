prepare() {
  cd "$pkgname-$_commit"
  patch -Np1 -i "$srcdir/pacman-update.patch"
  export CARGO_HOME="$srcdir/cargo" ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache"
  export ZIG="$srcdir/zig-x86_64-linux-$_zigver/zig"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
  (cd vendor/libghostty-vt && "$ZIG" build --fetch -Demit-lib-vt -Doptimize=ReleaseFast)
}

build() {
  cd "$pkgname-$_commit"
  export CARGO_HOME="$srcdir/cargo" CARGO_TARGET_DIR="$srcdir/target"
  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache" ZIG="$srcdir/zig-x86_64-linux-$_zigver/zig"
  export HERDR_BUILD_CHANNEL=stable
  export HERDR_BUILD_COMMIT="$_commit"
  export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cargo build --release --frozen
  python "$srcdir/licenses.py" "$srcdir/notices"
}

check() {
  cd "$pkgname-$_commit"
  export CARGO_HOME="$srcdir/cargo" CARGO_TARGET_DIR="$srcdir/target"
  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache" ZIG="$srcdir/zig-x86_64-linux-$_zigver/zig"
  export HERDR_BUILD_CHANNEL=stable HERDR_BUILD_COMMIT="$_commit" HERDR_DISABLE_SOUND=1
  export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cargo nextest run --frozen --workspace --no-fail-fast --test-threads 4 \
    --status-level fail --final-status-level fail
  python -m unittest scripts.test_vendor_libghostty_vt scripts.test_vendor_portable_pty \
    scripts.test_ui_hot_path_architecture scripts.test_config_reference_check \
    scripts.test_agent_detection_manifest_check
  [[ $("$srcdir/target/release/herdr" --version) == "herdr $_upstreamver" ]]
  "$srcdir/target/release/herdr" --default-config | grep '^# focus_pane_on_hover = false$' > /dev/null
}

package() {
  cd "$pkgname-$_commit"
  install -Dm755 "$srcdir/target/release/herdr" "$pkgdir/usr/bin/herdr"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  cp -a "$srcdir/notices/." "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 "$srcdir/simdutf-LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/simdutf/LICENSE-MIT"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "$startdir/README.md" "$pkgdir/usr/share/doc/$pkgname/PACKAGING.md"

  install -d "${pkgdir}/usr/share/bash-completion/completions"
  install -d "${pkgdir}/usr/share/fish/vendor_completions.d"
  install -d "${pkgdir}/usr/share/zsh/site-functions"
  "$srcdir/target/release/herdr" completion bash > "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
  "$srcdir/target/release/herdr" completion fish > "${pkgdir}/usr/share/fish/vendor_completions.d/${pkgname}.fish"
  "$srcdir/target/release/herdr" completion zsh > "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"
}
